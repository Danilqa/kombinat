{
  "name": "kombinat-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "cli": "tsx packages/cli/src/cli.ts",
    "serve": "tsx packages/cli/src/cli.ts serve",
    "dev": "tsx packages/cli/src/cli.ts dev",
    "tui": "tsx packages/cli/src/cli.ts tui",
    "cli:local": "tsx --env-file=.env.local packages/cli/src/cli.ts",
    "serve:local": "tsx --env-file=.env.local packages/cli/src/cli.ts serve",
    "dev:local": "tsx --env-file=.env.local packages/cli/src/cli.ts dev",
    "tui:local": "tsx --env-file=.env.local packages/cli/src/cli.ts tui",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter e2e run web-app",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "build": "pnpm --filter @danilqa/kombinat run build"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.0.9",
  "devDependencies": {
    "@danilqa/eslint-plugin-ts-pattern": "0.0.4",
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.3",
    "@types/react": "catalog:",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "eslint-plugin-unicorn": "78.0.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "tsx": "catalog:",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.71.2",
    "typescript7": "npm:typescript@7.0.2"
  }
}
