{
  "name": "@danilqa/kombinat",
  "version": "0.1.3",
  "type": "module",
  "description": "Dead simple, lightweight engine for 24/7 background AI agents. Works with your Claude, Codex or any other subscription.",
  "keywords": [
    "ai",
    "agents",
    "background-agents",
    "claude",
    "codex",
    "cron",
    "launchd",
    "routines",
    "scheduler"
  ],
  "license": "MIT",
  "homepage": "https://github.com/Danilqa/kombinat#readme",
  "bugs": "https://github.com/Danilqa/kombinat/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Danilqa/kombinat.git"
  },
  "bin": {
    "kombinat": "bin/kombinat.js"
  },
  "files": [
    "bin",
    "dist",
    "ui/dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "cli": "tsx src/cli.ts",
    "serve": "tsx src/cli.ts serve",
    "dev": "tsx src/cli.ts dev",
    "tui": "tsx src/cli.ts tui",
    "cli:local": "tsx --env-file=.env.local src/cli.ts",
    "serve:local": "tsx --env-file=.env.local src/cli.ts serve",
    "dev:local": "tsx --env-file=.env.local src/cli.ts dev",
    "tui:local": "tsx --env-file=.env.local src/cli.ts tui",
    "test": "tsx --test 'src/**/*.test.ts' 'ui/src/**/*.test.ts'",
    "typecheck": "tsc -p tsconfig.json && tsc -p ui/tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "ui:dev": "vite --config ui/vite.config.ts",
    "ui:build": "vite build --config ui/vite.config.ts",
    "build": "esbuild src/cli.ts --bundle --platform=node --format=esm --target=node24 --packages=external --outfile=dist/cli.js && pnpm ui:build",
    "prepack": "pnpm build"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.0.9",
  "dependencies": {
    "ts-pattern": "5.9.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@danilqa/eslint-plugin-ts-pattern": "0.0.4",
    "@eslint/js": "10.0.1",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-plugin-unicorn": "78.0.0",
    "globals": "17.13.0",
    "lucide-react": "1.49.0",
    "prettier": "3.9.10",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "react-router": "7.18.4",
    "remark-breaks": "4.0.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.71.2",
    "typescript7": "npm:typescript@7.0.2",
    "vite": "8.3.1"
  }
}
