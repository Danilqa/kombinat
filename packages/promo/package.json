{
  "name": "promo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "voice": "tsx scripts/voice.ts",
    "record": "pnpm --filter website build && vite build && tsx scripts/record.ts",
    "snapshot": "vite build && tsx scripts/snapshot.ts",
    "thumbnail": "vite build && tsx scripts/thumbnail.ts",
    "readme-gif": "pnpm --filter website build && tsx scripts/readme-gif.ts",
    "test": "tsx --test 'src/**/*.test.ts'",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "design-system": "workspace:*",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "ts-pattern": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-react": "6.1.1",
    "playwright": "1.65.0",
    "tsx": "catalog:",
    "vite": "8.3.1"
  }
}
