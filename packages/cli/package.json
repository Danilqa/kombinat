{
  "name": "@danilqa/kombinat",
  "version": "0.2.2",
  "type": "module",
  "description": "Dead simple, lightweight engine for 24/7 background AI agents. Works with your Claude, Codex or any other subscription.",
  "keywords": [
    "ai",
    "agents",
    "background-agents",
    "claude",
    "codex",
    "cron",
    "launchd",
    "routines",
    "scheduler",
    "systemd"
  ],
  "license": "MIT",
  "homepage": "https://github.com/Danilqa/kombinat#readme",
  "bugs": "https://github.com/Danilqa/kombinat/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Danilqa/kombinat.git"
  },
  "bin": {
    "kombinat": "bin/kombinat.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "tsx --test 'src/**/*.test.ts'",
    "typecheck": "tsc -p tsconfig.json",
    "build": "pnpm run build:cli && pnpm run build:web-app",
    "build:cli": "esbuild src/cli.ts --bundle --platform=node --format=esm --target=node24 --external:zod --external:ts-pattern --outfile=dist/cli.js",
    "build:web-app": "pnpm --filter web-app run build",
    "prepack": "pnpm run build && cp ../../README.md README.md"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "ts-pattern": "5.9.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "domains": "workspace:*",
    "esbuild": "0.28.2",
    "tsx": "catalog:",
    "tui": "workspace:*",
    "utils": "workspace:*"
  }
}
